  "types": [
    {
      "name": "PairState",
      "docs": [
        "One per buyer/seller pair: the highest session nonce opened so far. Never closed, so a",
        "session address (derived from the nonce) can't be reused once its session is closed."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "last_nonce",
            "type": "u64"
          },
