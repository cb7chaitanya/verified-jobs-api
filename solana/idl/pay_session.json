    "name": "pay_session",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Prepaid USDC payment sessions for pay-per-call APIs: deposit once, pay each call with an off-chain signed cumulative amount, redeem in batches."
  },
