    {
      "code": 6013,
      "name": "Overflow",
      "msg": "Arithmetic overflow"
    },
    {
      "code": 6014,
      "name": "UnsupportedMint",
      "msg": "Mints with Token-2022 extensions aren't supported"
    },
    {
      "code": 6015,
      "name": "NonceNotIncreasing",
      "msg": "Session nonce must be higher than any this buyer has used with this seller"
    }
