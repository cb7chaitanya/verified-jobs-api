# ---- Seller (the API server) ------------------------------------------------
# Each payee you set enables that way to pay. TESTNET addresses you control.
# The API server needs no private keys (unless you turn on the demo page, below).

# 1. Circle Gateway Nanopayments on Arc Testnet
EVM_PAY_TO=0xYourArcTestnetAddress
CIRCLE_GATEWAY_URL=https://gateway-api-testnet.circle.com

# 2. x402 exact on Solana devnet
SOLANA_PAY_TO=YourSolanaDevnetAddress
SOLANA_FACILITATOR_URL=https://x402.org/facilitator
# RPC used to confirm a settlement the facilitator reported as pending
SOLANA_RPC_URL=https://api.devnet.solana.com

# 3. pay_session (prepaid sessions) on Solana
SESSION_PAY_TO=YourSolanaSellerAddress
SESSION_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # devnet USDC
SESSION_RPC_URL=https://api.devnet.solana.com

PRICE=$0.001
PORT=3000
PUBLIC_URL=http://localhost:3000
LEDGER_PATH=./data/ledger.db
# Once registered on an ERC-8004-style identity registry:
# AGENT_REGISTRATIONS=[{"agentRegistry":"solana:<cluster>:<program>","agentId":"<id>"}]
# Identify yourself to job boards:
HTTP_USER_AGENT=verified-jobs-api/0.1

# ---- Seller's redemption worker (pnpm redeem) --------------------------------
# The only process that holds the seller key. It can only receive from session vaults.
SELLER_KEYPAIR=./data/seller.json
REDEEM_MIN_USDC=0.10
REDEEM_INTERVAL_SECONDS=300

# ---- Buyer (pnpm session / pnpm buyer) ---------------------------------------
BUYER_KEYPAIR=./data/buyer.json        # funds sessions; never signs per call
SESSION_FILE=./data/session.json       # written by `pnpm session open`
# EVM_PRIVATE_KEY=0x…                  # Arc Testnet key for Circle Gateway (testnet only)
# SOLANA_KEYPAIR=./data/buyer.json     # for x402 exact on devnet
SPEND_DB=./data/spend.db

# ---- Testnet demo page (off by default) --------------------------------------
# DEMO=1 serves a page at / where a buyer agent on THIS server pays the API, so the
# server then holds buyer keys. Testnet keys only, never a public mainnet deployment.
# DEMO=1
# DEMO_EVM_PRIVATE_KEY=0x…                    # Arc Testnet buyer with a Gateway deposit
# DEMO_SOLANA_KEYPAIR=./data/demo-buyer.json  # devnet buyer for exact and pay_session
# DEMO_SELLER_KEYPAIR=./data/seller.json      # optional: enables the "redeem now" button
# DEMO_DAILY_CAP_USDC=0.5
# DEMO_SESSION_DEPOSIT_USDC=0.05
# DEMO_DIR=./data                             # where per-session receipt keys are kept
